# Copy to .env and fill in. Never commit the real file — .env is gitignored.
# deploy.sh injects these into catalyst-config.json at deploy time; in CI they
# are reconstructed from GitHub Actions secrets.

# --- Zoho CRM (OAuth refresh-token flow, bulk read) ---
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=replace-me
ZOHO_REFRESH_TOKEN=1000.replace-me.replace-me

# --- WorkWave RouteManager (order submission) ---
WORKWAVE_API_KEY=replace-me
WORKWAVE_TERRITORY_ID=replace-me

# --- Resend (audit / summary email) ---
RESEND_API_KEY=re_replace_me
RESEND_FROM_ADDRESS=autobridge@example.com

# --- Catalyst File Store (run-artifact archiving) ---
# Currently non-functional: Catalyst's deploy API rejects any function
# env_variables key with a "CATALYST_" prefix as a reserved keyword (HTTP 400),
# so this can never be set through the normal deploy path under this name.
# Fixing it means renaming FILESTORE_FOLDER_ENV in src/main.py.
# CATALYST_RUN_ARTIFACTS_FOLDER_ID=
